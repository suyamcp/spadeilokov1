# LOCAL DEVELOPMENT / TESTING ENVIRONMENT
# This file is gitignored. Do NOT commit real credentials.

# ---------------------------------------------------------------------------
# DATABASE (Supabase - use the "Session pooler" connection string, port 5432)
# Connect button in the Supabase dashboard -> Session pooler.
# Example string:
#   postgresql://postgres.abcxyz:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
SQL_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SQL_PORT=5432
SQL_USER=postgres.libjiccaqkuqlwhwsiyo
SQL_PASSWORD=jambajuicy123
SQL_DB_NAME=postgres
SQL_ADMIN_USER=postgres.libjiccaqkuqlwhwsiyo
SQL_ADMIN_PASSWORD=jambajuicy123
# Supabase requires TLS. Keep this true for Supabase/Neon/RDS; the hosting
# platform's Cloud SQL leaves it unset.
SQL_SSL=true

# ---------------------------------------------------------------------------
# EMAIL (SMTP) — sends payment instructions to the guest + a heads-up to staff.
# Optional: if SMTP_HOST is blank, bookings still work and the ticket still
# shows everything; the email is just skipped (logged to the server console).
# Gmail example: host smtp.gmail.com, port 587, user = your address,
# pass = a Google "App Password" (not your login password).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=suyamcarlpaulo@gmail.com
SMTP_PASS=ciwiroprshwewxuu
SMTP_FROM=Spa de Iloko <suyamcarlpaulo@gmail.com>

# ---------------------------------------------------------------------------
# ADMIN BOOTSTRAP — read ONLY when the database has no admin account yet.
# Never commit real values (this file is gitignored). Leave the password blank
# and the server will generate a random one and print it to the console once.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=valleypointcampsite@gmail.com
ADMIN_INITIAL_PASSWORD=12345678TEST
